# Server Configuration
PORT=4000
NODE_ENV=development
TRUST_PROXY=0

# Database Configuration (MySQL 8)
DATABASE_URL="mysql://venturematch:venturematch_pass@localhost:3306/venturematch"

# Secrets (Minimum 32 random characters for production)
